http://{$CADDY_SITE:localhost} {
    redir {$HTTPS_ORIGIN:https://localhost:8443}{uri} 308
}

{$CADDY_SITE:localhost} {
    encode zstd gzip

    # Explicit public application routes. WAHA and Caddy administration never proxy.
    @read {
        method GET HEAD
        # / redirects to the private Hub, which is intentionally not proxied.
        # The previously public planner form is now explicitly /planner.
        path / /planner /health /static/* /trip/* /api/viewer/* /api/trips/*
    }
    @create {
        method POST
        path /api/trips /api/webhooks/waha
    }
    handle @read {
        reverse_proxy api:8000
    }
    handle @create {
        reverse_proxy api:8000
    }
    handle {
        respond "Not found" 404
    }
}
