# Copy to repository root as .env.prod. Use the SAME project/region/repo/image as DEV.
# Deployment configuration (not forwarded to the application):
GCP_PROJECT_ID=
GCP_REGION=europe-central2
GCP_ARTIFACT_REPO=tripse-ai
GCP_IMAGE_NAME=tripse-ai
GCP_SERVICE_NAME=tripse-ai-prod
GCP_PUBLIC_ACCESS=true
GCP_MIN_INSTANCES=0
GCP_MAX_INSTANCES=1
GCP_CPU=1
GCP_MEMORY=512Mi
# Runtime whitelist. PROD is still a readonly demo, not the full production system.
APP_ENV=prod
PLANNING_MODE=mock
CLOUD_FEATURE_MODE=readonly_demo
# Keep this default until DEV acceptance and explicit manual digest promotion.
# To opt into cloud_demo set GCP_PUBLIC_ACCESS=false and add the following exact
# PROD resource fields, plus reviewed IAP membership (no credential values):
# GCP_PROJECT_NUMBER=REPLACE
# PUBLIC_BASE_URL=https://REPLACE.run.app
# IAP_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
# DEMO_EDITORS=operator@example.com
# DEMO_READERS=reader@example.com
# GCP_DOCUMENT_BUCKET=PROJECT_ID-tripse-ai-prod-documents
# GCP_FIRESTORE_DATABASE=tripse-ai-prod
# GCP_TASK_QUEUE=projects/PROJECT_ID/locations/europe-central2/queues/tripse-ai-prod
# GCP_TASK_ACCOUNT=tripse-ai-prod-tasks@PROJECT_ID.iam.gserviceaccount.com
# Optional, independently approved browser key (never a server key):
# GCP_BROWSER_MAPS_SECRET=projects/PROJECT_ID/secrets/tripse-ai-prod-maps-browser/versions/1
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
