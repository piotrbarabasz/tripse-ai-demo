# Copy to repository root as .env.dev. This file contains NO credentials.
# Deployment configuration (not forwarded to the application):
GCP_PROJECT_ID=
GCP_REGION=europe-central2
GCP_ARTIFACT_REPO=tripse-ai
GCP_IMAGE_NAME=tripse-ai
GCP_SERVICE_NAME=tripse-ai-dev
GCP_PUBLIC_ACCESS=true
GCP_MIN_INSTANCES=0
GCP_MAX_INSTANCES=1
GCP_CPU=1
GCP_MEMORY=512Mi
# Runtime whitelist:
APP_ENV=dev
PLANNING_MODE=mock
CLOUD_FEATURE_MODE=readonly_demo
# Opt-in cloud_demo: change mode above and GCP_PUBLIC_ACCESS=false, then add ALL
# fields below (uncomment and replace literals; interpolation is forbidden).
# Keep .env.prod unchanged during DEV validation. See docs/CLOUD_PARITY_AUDIT.md.
# GCP_PROJECT_NUMBER=REPLACE
# PUBLIC_BASE_URL=https://REPLACE.run.app
# IAP_OAUTH_CLIENT_ID=REPLACE.apps.googleusercontent.com
# DEMO_EDITORS=operator@example.com|editor@example.com
# DEMO_READERS=reader@example.com
# GCP_DOCUMENT_BUCKET=PROJECT_ID-tripse-ai-dev-documents
# GCP_FIRESTORE_DATABASE=tripse-ai-dev
# GCP_TASK_QUEUE=projects/PROJECT_ID/locations/europe-central2/queues/tripse-ai-dev
# GCP_TASK_ACCOUNT=tripse-ai-dev-tasks@PROJECT_ID.iam.gserviceaccount.com
# Optional paid browser Maps, only after budget/referrer/API restrictions review:
# GCP_BROWSER_MAPS_SECRET=projects/PROJECT_ID/secrets/tripse-ai-dev-maps-browser/versions/1
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
