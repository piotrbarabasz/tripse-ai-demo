# Compose settings. No API keys are required in Task 01.
API_PORT=8000
WORKER_POLL_SECONDS=1
# Native Python only; Compose always uses /data/tripse.sqlite3 on its shared volume.
DATABASE_PATH=data/tripse.sqlite3

# WhatsApp profile only. Generate two different random secrets (see docs/WAHA.md).
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=
# Deny all by default. Exact comma-separated WAHA sender IDs, e.g. 48123456789@c.us.
# Only explicitly allowed testers; pair WAHA with a dedicated test number.
WAHA_ALLOWED_SENDERS=

# Task 03. Live is the default; missing keys cause a readable failed job.
# Use mock explicitly for a no-key, no-cost demonstration.
PLANNING_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Shared server key, or separate keys for the two APIs below.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
# Reachable HTTP(S) origin for viewer links; use your DEV HTTPS URL for WhatsApp.
PUBLIC_BASE_URL=http://localhost:8000

# Task 04. A DIFFERENT key, restricted to Maps JavaScript API + your HTTP referrers.
# Never use GOOGLE_MAPS_API_KEY / Places / Routes server credentials here.
GOOGLE_MAPS_BROWSER_KEY=
# DEMO_MAP_ID works for local development; use your own map ID on DEV hosting.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Task 05 local HTTPS (--profile dev). No public certificate is claimed for localhost.
CADDY_SITE=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Public compose.dev.yaml only: bare DNS hostname pointing at the DEV host.
DEV_DOMAIN=
